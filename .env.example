# Environment Variables for Personal Budget Assistant
# Choose one of the LLM options below (Groq, GitHub Models, or OpenAI)

# Option 1: Groq API (High-speed & Free Tier - Recommended)
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Option 2: GitHub Models (Free tier with your GitHub Personal Access Token)
# Get token at: https://github.com/settings/tokens (classic token with read:packages or fine-grained)
# GITHUB_TOKEN=your_github_token_here
# LLM_BASE_URL=https://models.inference.ai.azure.com
# LLM_MODEL=gpt-4o-mini

# Option 3: OpenAI API
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini
